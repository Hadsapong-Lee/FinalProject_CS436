@page
@model LoginModel

@{

    ViewData["Title"] = "Login";
    Layout = "~/Pages/Shared/_AccountLayout.cshtml";
}

<div class="account-container">
    <div class="account-box">
        <h2 class="text-center mb-4">LOGIN</h2>
        <form id="account" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="Input.Username" class="form-label"></label>
                <input asp-for="Input.Username" class="form-control" placeholder="Username" />
                <span asp-validation-for="Input.Username" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.Password" class="form-label"></label>
                <input asp-for="Input.Password" class="form-control" placeholder="************" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>
            @* Forgot Pass *@
            <div class="float-end">
                <a asp-area="" asp-page="/Account/VerifyUsername" class="text-decoration-none">
                    Forgot password?    
                </a>
            </div>
            <div class="form-check mb-3">
                <label class="form-check-label">
                    <input asp-for="Input.RememberMe" class="form-check-input"/>
                    @Html.DisplayNameFor(a=> a.Input.RememberMe)
                </label>
            </div>
            <div class="submit-btn-wrap">
                <input type="submit" value="CONTINUE" class="btn btn-success w-100 p-2" />  
                <span>&#8250;</span>
            </div>
            <p class="text-center mt-2">                 
                Don't have an account? <a class="text-decoration-none" asp-area="Identity" asp-page="/Account/Register">Register</a>
            </p>
            <div class="text-center">
                <a asp-area="" asp-page="/Index" class="text-decoration-none mt-3">Back</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
