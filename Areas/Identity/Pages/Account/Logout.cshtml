@page
@model LogoutModel

@{

    ViewData["Title"] = "Logout";
    Layout = "~/Pages/Shared/_AccountLayout.cshtml";
}

<div class="account-container">
    <div class="account-box">
        @{
            if (User.Identity?.IsAuthenticated ?? true)
            {
                <h2 class="text-center mb-5"><span class="h1 text-warning">ERROR OCCUR!</span><br/> <span class="text-black-50" style="line-height:1.8em">Please Logout</span></h2>
                <form class="form-inline text-center" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/", new { area = "" })" method="post">
                    <button type="submit" class="text-decoration-none btn btn-primary">Click here to logout</button>
                </form>
            }
            else
            {
                <h2 class="text-center mb-4">LOGOUT SUCCESFUL</h2>
                <p class="text-center mb-2">You have successfully logged out of the application.</p>
            }
        }
    </div>
</div>

