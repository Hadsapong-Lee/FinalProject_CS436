    <div class="account-container">
        <div class="account-box">
            <span class="text-end">
                <a asp-area="" asp-page="/Index" class="btn btn-secondary mt-2"><span style="font-size:24px; padding-bottom:6.5px;">&#8249</span></a>
            </span>
            <h2 class="text-center mb-4">WRITE EMAIL</h2>

            <form id="account" method="post">

                <div class="mb-3">
                    <label class="form-label" for="recipient">To:</label>
                    <input class="form-control mt-2" type="text" id="recipient" name="EmailReceiver" required />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="subject">Subject:</label>
                    <input class="form-control mt-2" type="text" id="subject" name="EmailSubject" required />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="message">Message:</label>
                    <textarea class="form-control mt-2" id="message" name="EmailMessage" rows="4" required></textarea>
                </div>
                <div class="submit-btn-wrap text-end">
                    <input type="submit" value="SEND" class="btn btn-success w-25 p-2 mb3" />
                    <span>&#8250;</span>
                </div>
            </form>
        </div>
    </div>
    </body>

