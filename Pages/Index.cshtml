@page "/index"
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<table class="table">
    <thread>
        <tr>
            <th>From</th>
            <th>Subject</th>
            <th>Date/Time</th>
            <th>Delete</th>
        </tr>
    </thread>

    <tbody>
        @foreach (var item in Model.listEmails)
        {
            <tr>
                <td>@item.EmailSender</td>
                <td>
                    @if (item.EmailIsRead.Equals("0")) {
                        <img src="images/yellow.gif" height="10pt"> 
                    } 
                    <a href="MailSystem/ReadEmail?emailid=@item.EmailID">@item.EmailSubject</a></td>
                <td>@item.EmailDate</td>
                <td>
                    <a class="btn btn-primary btn-sm" href="MailSystem/DeleteEmail?emailid=@item.EmailID">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (User.Identity.IsAuthenticated)
{
    <a class="float-end btn btn-primary btn-sm" href="MailSystem/ComposeMail?Sender=@User.Identity.Name">Compose New Email</a>
}
else{
    <p class="text-center mb-5 pt-5 text-muted lead">Please Log In To Continue</p>
}