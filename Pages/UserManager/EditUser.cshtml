@page
@model FinalProject.Pages.UserManager.EditUserModel
@{
}

<head>
	<title>@ViewData["Title"]</title>
	<link rel="stylesheet" href="~/css/user.css" asp-append-version="true" />

</head>

<div class="account-container">
	<div class="account-box">
        <div class="text-center prime-header text-white" style="background: #6369E2;">
            <h2 class="text-center mb-2 mt-2">EDIT USER</h2>
        </div>

        <div class="input-group mb-0">
            <span class="input-group-text">Username :</span>
            <label type="text" class="form-control top-label">@Model.UserName</label>
        </div>
        <div class="input-group mb-0">
            <span class="input-group-text" style="border-top:0; border-left:0; border-radius:0;">First Name :</span>
            <label type="text" class="form-control top-label" style="border-top:0; border-right:0; border-radius:0;">@Model.FirstName</label>
        </div>
	</div>
</div>