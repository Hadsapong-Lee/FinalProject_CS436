@page
@model FinalProject.Pages.ReadEmailModel
@{
    ViewData["Title"] = "Reading Email";
}

<head>
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/emails.css" asp-append-version="true" />
</head>

<div class="account-container">
    <div class="account-box">
        <span class="text-end">
            <a asp-area="" asp-page="/Index" class="btn btn-secondary mt-2"><span style="font-size:24px; padding-bottom:6.5px;">&#8249</span></a>
        </span>
    <h2 class="text-center mb-4">@ViewData["Title"]</h2>

    @if (true)
    {
        <div>
            <div class="mb-3">
                <label class="form-label">From:</label>
                <input class="form-control mt-2" type="text" value="@Model.EmailSender" readonly />
            </div>

            <div class="mb-3">
                <label class="form-label">To:</label>
                <input class="form-control mt-2" type="text" value="@Model.EmailReceiver" readonly />
            </div>

            <div class="mb-3">
                <label class="form-label">Subject:</label>
                <input class="form-control mt-2" type="text" value="@Model.EmailSubject" readonly />
            </div>

            <div class="mb-3">
                <label class="form-label">Date:</label>
                <input class="form-control mt-2" type="text" value="@Model.EmailDate" readonly />
            </div>

            <div class="mb-3">
                <label class="form-label">Subject:</label>
                <input class="form-control mt-2" type="text" value="@Model.EmailSubject" readonly />
            </div>
            <h6 class="mb-2">Message:</h6>
            <div class="email-message" style="color: #666;">@Html.Raw(Model.EmailMessage)</div>
        </div>
    }
    </div>
</div>

