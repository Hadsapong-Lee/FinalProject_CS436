@page
@model FinalProject.Pages.MailSystem.AdminModel
@{
}

<h2>User Management</h2>

<table class="table mt-5">
    <thead class="table-custom">
        <tr>
            <th class="custom-text-white">FROM</th>
            <th class="custom-text-white">SUBJECT</th>
            <th class="custom-text-white">DATE/TIME</th>
            <th class="custom-text-white"></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model.UserList)
        {
            <tr>
                <td>@item.EmailSender</td>
                <td>
                    @if (item.EmailIsRead.Equals("0"))
                    {
                        <img src="images/yellow.gif" height="10pt">
                    }
                    @item.EmailSubject
                </td>
                <td>@item.EmailDate</td>
                <td class="text-end">
                    <a class="btn btn-success btn-sm w-25" href="MailSystem/ReadEmail?emailid=@item.EmailID">View</a>
                    <a class="btn btn-danger btn-sm w-25" href="MailSystem/DeleteEmail?emailid=@item.EmailID">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>