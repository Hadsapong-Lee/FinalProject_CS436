@page
@model ComposeMailModel
@{
    ViewData["Title"] = "Sending Mail";
}

<head>
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/emails.css" asp-append-version="true" />

</head>
<body>

    <div class="account-container">
        <div class="account-box">
            <span class="text-end">
                <a asp-area="" asp-page="/Index" class="btn btn-secondary mt-2"><span style="font-size:24px; padding-bottom:6.5px;">&#8249</span></a>
            </span>
            <h2 class="text-center mb-4">WRITE EMAIL</h2>

            <div class="mb-3">
                <label class="form-label">From:</label>
                <input class="form-control mt-2" type="text" value="@Model.EmailSender" readonly />
            </div>

            <form id="account" method="post">
                <div class="mb-3">
                    <label asp-for="EmailReceiver" class="form-label">To:</label>
                    <input asp-for="EmailReceiver" class="form-control mt-2" placeholder="Receiver Username" required />
                    <span asp-validation-for="EmailReceiver" class="text-warning"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="EmailSubject" class="form-label">Subject:</label>
                    <input asp-for="EmailSubject" class="form-control mt-2" required />
                </div>
                <div class="mb-3">
                    <label asp-for="EmailMessage" class="form-label">Message:</label>
                    <textarea asp-for="EmailMessage" class="form-control mt-2" required></textarea>
                </div>
                <div class="submit-btn-wrap text-end">
                    <input type="submit" value="SEND" class="btn btn-success w-25 p-2 mb3" />
                    <span>&#8250;</span>
                </div>
            </form>
        </div>
    </div>
</body>

