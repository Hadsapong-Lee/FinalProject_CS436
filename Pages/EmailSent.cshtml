@page
@model FinalProject.Pages.EmailSentModel
@{
}

<head>
    <title>@ViewData["Title"]</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
        }

        .email-sent-text {
            color: #fff;
            text-align: center;
            font-size: 18px;
            margin-bottom: 20px;
            margin-top: 78px; 
        }


        .home-button {
            border-radius: 20px;
            padding: 10px 20px;
            text-decoration: none;
            background-color: #fff;
            transition: background-color 0.3s ease-in-out;
            font-weight: bold;
            color: black;

            display: flex;
            justify-content: center;
            align-items: center;
            position: fixed; 
            top: 25%;
            left: 50%;
            transform: translate(-50%, -50%);
        }

    </style>
</head>
<body>
    <div class="email-container">

        <p class="email-sent-text">Your email has been sent successfully.</p>

        <a class="home-button" href="/Index">Home</a>
    </div>
</body>
